# 复制为 .env 后按本机改；.env 不进仓库。
# 三台机器允许不同的只有 KFC_DB_SERVER 与 KFC_DB_DRIVER，其余键冻结后不再改。

# 本机实例名：A 的机器是 localhost；B / C 换成 localhost\MSSQLSERVER2 或 .\SQLEXPRESS 即可
KFC_DB_SERVER=localhost
KFC_DB_NAME=KFC_DB

# 三台机器必须装同一个驱动（计划 §8.2），连接串里显式写名字，不依赖默认驱动
KFC_DB_DRIVER=ODBC Driver 18 for SQL Server

# ODBC Driver 18 默认强制加密；本机自签证书需要信任，生产部署改成 no 并配可信证书
KFC_DB_ENCRYPT=yes
KFC_DB_TRUST_CERT=yes

KFC_DB_QUERY_TIMEOUT=30

# 会话签名密钥。C 的登录层把员工数据库登录放进 Flask 会话，签名靠它。
# 本机不填也行（应用会现生成一把，重启后要重新登录）；演示环境请填一个固定值。
# 只放本机 .env，不入库。
KFC_SECRET_KEY=

# 仅本地冒烟用：用 Windows 信任连接登录（此时 USER_NAME() 是 dbo）。
# 正常业务请求一律按员工本人的数据库登录连接——员工的 database_user_name 才能映射到
# EmployeeAccount，岗位守卫和工作过程靠这个认人。此项不得在演示环境打开。
KFC_DB_TRUSTED_CONNECTION=no
